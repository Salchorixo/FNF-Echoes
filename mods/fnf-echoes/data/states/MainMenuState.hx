import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import funkin.backend.scripting.ModState;
import funkin.backend.scripting.Script;
import funkin.backend.utils.CoolUtil;
import funkin.menus.TitleState;
import funkin.menus.credits.CreditsMain;

// Main menu, from Zyra's sketch ("before the crash" version): a stack of buttons on the left, Zyra
// sitting on his sofa with headphones in the middle, a folder (art, sketches, cutscenes...)
// top-right and a spinning vinyl (the menu music) bottom-right, on a white background. Zyra and the
// sofa are the real hand-drawn animation (see createSketch()). The buttons, folder and vinyl are in the
// common language of the menus (BE-13): Windows Vista glass, pixel art at 3x with a pencil outline
// drawn over it (images/menus/main/ui/vista_*.png, generated by AI_export_main_menu_vista.py; layout
// numbers below mirror AI_build_vista_kit.py). The music notes are particles (notes.png). The old XP
// sketches (xp_*.png) stay in the folder for the future XP theme (see menuVariant).
// There is no VHS/CRT shader on this screen on purpose (Zyra's call, 2026-10-11: no curvature,
// no filters for now); to bring it back, call vhsShader's attach() in create().
//
// Intro: the animation plays once (Zyra falls onto a floating sofa, which tumbles upright and
// settles), the music and the notes start on the frame where he lands, then the buttons slide
// in and the folder and the vinyl pop in. After that the idle loop repeats. ACCEPT during the
// intro skips it. Every timing is a variable below, to be tuned by eye.
//
// buttonKeys stays the stable English keys — confirmSelection() switches on these regardless
// of the display language, so what is shown never affects the navigation. Settings still opens
// OptionsState (the screen keeps its name; only the label changed). Credits reuses the
// engine's native screen: it is a utility screen, not narrative.
//
// Focus: the button stack ("stack") or the folder icon ("folder"). Up/Down move through the
// buttons, Right jumps to the folder, Left/Down comes back. The mouse works too (hover selects,
// click confirms; hover only counts while the mouse actually moves).

// "normal" is the menu before the crash. The broken menu (after crash 1: Kiyu gone, glitched
// logo, odd options) is a later variant; nothing reads this yet.
var menuVariant:String = "normal";

var buttonKeys:Array<String> = ["PLAY", "SETTINGS", "CREDITS"];
var buttons:Array<FlxSprite> = [];
var buttonLabels:Array<FlxText> = [];
var buttonShadows:Array<FlxText> = [];
var labelShadow:Float = 2;
var selectedIndex:Int = 0;
var focus:String = "stack";
var i18n:Script;

// Button sprites carry a margin of pencil overshoot around the visible rectangle, so the sprite is
// drawn buttonPad px up-left of x,y and its hitbox is just the visible rectangle. Each button has its
// own sheet (a different pencil stroke): frame 0 normal, frames 1-24 selected (the cyan glow pulses).
// The label is navy text with a white shadow, as in Vista.
var buttonX:Float = 72;
var buttonWidth:Int = 270;
var buttonHeight:Int = 114;
var buttonGap:Int = 44;
var buttonPad:Int = 26;
var selectedShift:Float = 26;

// Zyra on his sofa: hand-drawn sketch frames rendered at 1920x1080 on a transparent background,
// packed as a multi-page atlas (images/menus/main/sketch/, built by AI_pack_atlas.py, see
// Receta J in docs/agents/03_RECETAS.md). Frames m_0000-m_0125 are the intro (played once),
// m_0126-m_0275 the idle loop. They were rendered at 60 fps. The sprite covers the whole
// screen, so every frame keeps its own place in the picture.
var sketch:FlxSprite;
var sketchIntroLastFrame:Int = 125;
var sketchLoopLastFrame:Int = 275;
var sketchFps:Float = 60;
// Intro frame where Zyra hits the sofa (the sketch's own impact); the music starts there.
var sketchLandFrame:Int = 42;

// Menu music (Soul, 150 BPM): the OST (menuOst.ogg) plays first; on the landing frame the
// instrumental (menuInst.ogg) starts at its drop, instStartSeconds into the track. instMusicId
// tags the sound object so we can tell which of the two is playing.
var songBpm:Float = 150;
var instStartSeconds:Float = 26;
var instMusicId:Int = 1;

// Where the headphones sit in the final pose, in screen pixels (1280x720): the notes come out of
// the two cups. Move these if the animation changes.
var cupLeftX:Float = 560;
var cupRightX:Float = 750;
var cupY:Float = 250;

// Folder (top-right) and vinyl (bottom-right corner, cropped by the screen edge). The vinyl centre
// sits just inside the corner, so roughly half of the disc shows.
var folderWidth:Int = 132;
var folderHeight:Int = 98;
var folderPad:Int = 20;
var folderX:Float = 1112;
var folderY:Float = 34;
var vinylCenterX:Float = 1228;
var vinylCenterY:Float = 676;
var vinylRadius:Float = 140;
var vinylSize:Int = 300; // native 100 px at 3x
var vinylFps:Float = 10; // 24 frames: one turn every 2.4 s
var vinyl:FlxSprite;
var vinylPencil:FlxSprite;
var folder:FlxSprite;
var folderRestY:Float = 0;

// Intro timings (seconds). The sketch intro lasts 126 frames at 60 fps = 2.1 s, so the UI comes
// in while the sofa rights itself and Zyra sits down (frames ~90-125).
var buttonsStart:Float = 1.4;
var buttonStagger:Float = 0.1;
var buttonSlideTime:Float = 0.45;
var iconsStart:Float = 1.7;
var introEnd:Float = 2.1;
var introDone:Bool = false;
var landed:Bool = false;
var introTimers:Array<FlxTimer> = [];

// Music notes: a small pool of sprites reused as particles. Each one is a random shape from the
// notes sheet (6 shapes x 2 colour rows: row 0 blue for Zyra's headphones, row 1 red for the
// vinyl). They rise, sway, tilt and fade. Emitters are plain objects, see buildParticles().
var noteCols:Int = 6;
var noteCellW:Int = 64;
var noteCellH:Int = 76;
var poolSize:Int = 30;
var notePool:Array<FlxSprite> = [];
var noteAge:Array<Float> = [];
var noteLife:Array<Float> = [];
var noteVx:Array<Float> = [];
var noteVy:Array<Float> = [];
var noteSway:Array<Float> = [];
var noteSwayRate:Array<Float> = [];
var notePhase:Array<Float> = [];
var noteScale:Array<Float> = [];
var emitters:Array<Dynamic> = [];

var lastMouseX:Float = -1;
var lastMouseY:Float = -1;

function create() {
	FlxG.camera.scroll.set(0, 0); // every screen resets its own camera
	bgColor = FlxColor.WHITE;

	i18n = Script.create(Paths.script('scripts/ui/translate'));
	i18n.load();

	// The OST of song 1 is what plays first; the instrumental takes over at the landing.
	if (FlxG.sound.music == null || !FlxG.sound.music.playing)
		CoolUtil.playMusic(Paths.music('menuOst'), true, 1, true, songBpm);

	createSketch();
	buildButtons();
	buildFolder();
	buildVinyl();
	buildParticles();

	FlxG.mouse.visible = true;
	updateHighlight();
	playIntro();
}

// ---------------------------------------------------------------- building

function buildButtons() {
	var totalHeight = (buttonHeight * buttonKeys.length) + (buttonGap * (buttonKeys.length - 1));
	var startY = (FlxG.height - totalHeight) / 2;
	var cellW = buttonWidth + buttonPad * 2;
	var cellH = buttonHeight + buttonPad * 2;

	for (i in 0...buttonKeys.length) {
		var button = new FlxSprite(-buttonWidth - 60, startY + i * (buttonHeight + buttonGap));
		button.loadGraphic(Paths.image('menus/main/ui/vista_button_' + i), true, cellW, cellH);
		button.animation.add('glow', [for (f in 1...25) f], 12, true);
		button.animation.frameIndex = 0;
		button.width = buttonWidth;
		button.height = buttonHeight;
		button.offset.set(buttonPad, buttonPad);
		button.antialiasing = true;
		add(button);
		buttons.push(button);

		var text = i18n.call("get", [buttonKeys[i]]);
		var labelY = button.y + (buttonHeight / 2) - 18;
		var shadow = new FlxText(button.x + labelShadow, labelY + labelShadow, buttonWidth, text);
		shadow.setFormat(Paths.font("vcr.ttf"), 34, FlxColor.WHITE, "center");
		shadow.alpha = 0.8;
		add(shadow);
		buttonShadows.push(shadow);

		var label = new FlxText(button.x, labelY, buttonWidth, text);
		label.setFormat(Paths.font("vcr.ttf"), 34, 0xFF183464, "center");
		add(label);
		buttonLabels.push(label);
	}
}

// Zyra on his sofa, from the packed sketch frames. The frames keep their full 1920x1080 canvas
// (trimmed ones carry an offset), so scaling the sprite to the screen keeps every frame in place.
function createSketch() {
	sketch = new FlxSprite();
	sketch.frames = Paths.getFrames('menus/main/sketch');
	sketch.animation.addByIndices('intro', 'm_', [for (i in 0...(sketchIntroLastFrame + 1)) i], '', sketchFps, false);
	sketch.animation.addByIndices('loop', 'm_', [for (i in (sketchIntroLastFrame + 1)...(sketchLoopLastFrame + 1)) i], '', sketchFps, true);
	sketch.animation.onFinish.add((name) -> if (name == 'intro') sketch.animation.play('loop'));
	// >= and not ==: if a frame is dropped the landing must still fire.
	sketch.animation.onFrameChange.add((name, frameNumber, frameIndex) -> if (name == 'intro' && frameNumber >= sketchLandFrame) onLanded());

	sketch.setGraphicSize(FlxG.width);
	sketch.updateHitbox();
	sketch.setPosition(0, 0);
	sketch.antialiasing = true;
	add(sketch);
}

// Folder (art, sketches, cutscenes...): Vista style with a paper, top-right. It opens nothing yet.
function buildFolder() {
	folder = new FlxSprite(folderX, folderY);
	folder.loadGraphic(Paths.image('menus/main/ui/vista_folder'));
	folder.width = folderWidth;
	folder.height = folderHeight;
	folder.offset.set(folderPad, folderPad);
	folder.antialiasing = true;
	folderRestY = folder.y;
	folder.scale.set(0, 0);
	add(folder);
}

// The record that plays the menu music, in the bottom-right corner: pixel art with 24 frames (the
// spin is in the frames) and a pencil circle around it that does not turn.
function buildVinyl() {
	vinyl = new FlxSprite();
	vinyl.loadGraphic(Paths.image('menus/main/ui/vista_vinyl'), true, vinylSize, vinylSize);
	vinyl.animation.add('spin', [for (f in 0...24) f], vinylFps, true);
	vinyl.setPosition(vinylCenterX - vinylSize / 2, vinylCenterY - vinylSize / 2);
	vinyl.antialiasing = false;
	vinyl.scale.set(0, 0);
	add(vinyl);

	vinylPencil = new FlxSprite();
	vinylPencil.loadGraphic(Paths.image('menus/main/ui/vista_vinyl_pencil'));
	vinylPencil.setPosition(vinylCenterX - vinylPencil.width / 2, vinylCenterY - vinylPencil.height / 2);
	vinylPencil.antialiasing = true;
	vinylPencil.scale.set(0, 0);
	add(vinylPencil);
}

// Particle pool plus the three emitters (the two headphone cups and the vinyl). gapMin/gapMax is
// the random time between notes in seconds; row picks the colour row of the sheet.
function buildParticles() {
	for (i in 0...poolSize) {
		var note = new FlxSprite();
		note.loadGraphic(Paths.image('menus/main/ui/notes'), true, noteCellW, noteCellH);
		note.antialiasing = true;
		note.visible = false;
		add(note);
		notePool.push(note);
		noteAge.push(0.0);
		noteLife.push(1.0);
		noteVx.push(0.0);
		noteVy.push(0.0);
		noteSway.push(0.0);
		noteSwayRate.push(1.0);
		notePhase.push(0.0);
		noteScale.push(1.0);
	}

	emitters = [
		{vinyl: false, x: cupLeftX, y: cupY, dir: -1, row: 0, gapMin: 0.7, gapMax: 1.5, scaleMin: 0.85, scaleMax: 1.15, timer: 0.2},
		{vinyl: false, x: cupRightX, y: cupY, dir: 1, row: 0, gapMin: 0.7, gapMax: 1.5, scaleMin: 0.85, scaleMax: 1.15, timer: 0.8},
		{vinyl: true, x: 0, y: 0, dir: -1, row: 1, gapMin: 0.8, gapMax: 1.6, scaleMin: 0.55, scaleMax: 0.8, timer: 0.5}
	];
}

// ---------------------------------------------------------------- intro

function later(seconds:Float, callback) {
	var timer = new FlxTimer().start(seconds, callback);
	introTimers.push(timer);
}

function playIntro() {
	// The sketch drives its own timing; onLanded() fires from its frame callback.
	sketch.animation.play('intro');

	for (i in 0...buttons.length) {
		var index = i;
		later(buttonsStart + index * buttonStagger, (_) -> {
			FlxTween.tween(buttons[index], {x: buttonX}, buttonSlideTime, {ease: FlxEase.backOut});
			FlxTween.tween(buttonLabels[index], {x: buttonX}, buttonSlideTime, {ease: FlxEase.backOut});
			FlxTween.tween(buttonShadows[index], {x: buttonX + labelShadow}, buttonSlideTime, {ease: FlxEase.backOut});
		});
	}

	later(iconsStart, (_) -> popIn(folder));
	later(iconsStart + 0.12, (_) -> {
		popIn(vinyl);
		popIn(vinylPencil);
	});
	later(introEnd, (_) -> finishIntro());
}

function popIn(sprite:FlxSprite) {
	FlxTween.tween(sprite.scale, {x: 1, y: 1}, 0.4, {ease: FlxEase.backOut});
}

// Zyra hit the sofa (the squash and bounce are in the drawn frames): the music starts and the
// notes begin to come out (updateParticles() waits for `landed`).
function onLanded() {
	if (landed) return;
	landed = true;

	// The instrumental of song 1 comes in on the landing, jumping straight to its drop. If it is
	// already playing (coming back from Settings) nothing restarts.
	if (FlxG.sound.music == null || !FlxG.sound.music.playing || FlxG.sound.music.ID != instMusicId) {
		CoolUtil.playMusic(Paths.music('menuInst'), true, 1, true, songBpm);
		FlxG.sound.music.ID = instMusicId;
		FlxG.sound.music.time = instStartSeconds * 1000;
	}

}

// Take a free particle, give it a random shape and launch it from the emitter.
function spawnNote(e) {
	var index = -1;
	for (i in 0...notePool.length) {
		if (!notePool[i].visible) {
			index = i;
			break;
		}
	}
	if (index < 0) return;

	var note = notePool[index];
	var x = e.x + FlxG.random.float(-6, 6);
	var y = e.y + FlxG.random.float(-8, 8);
	if (e.vinyl) {
		// Anywhere along the visible upper-left rim of the disc.
		var angle = FlxG.random.float(200, 262) * Math.PI / 180;
		x = vinylCenterX + Math.cos(angle) * vinylRadius * 0.92;
		y = vinylCenterY + Math.sin(angle) * vinylRadius * 0.92;
	}

	note.animation.frameIndex = e.row * noteCols + FlxG.random.int(0, noteCols - 1);
	var size = FlxG.random.float(e.scaleMin, e.scaleMax);
	note.scale.set(size, size);
	note.setPosition(x - noteCellW / 2, y - noteCellH / 2);
	note.alpha = 0;
	note.visible = true;

	noteAge[index] = 0.0;
	noteLife[index] = FlxG.random.float(2.4, 3.6);
	noteVx[index] = e.dir * FlxG.random.float(26, 58);
	noteVy[index] = -FlxG.random.float(38, 78);
	noteSway[index] = FlxG.random.float(10, 26);
	noteSwayRate[index] = FlxG.random.float(1.4, 2.6);
	notePhase[index] = FlxG.random.float(0, 6.28);
	noteScale[index] = size;
}

function updateParticles(elapsed:Float) {
	if (!landed) return;

	for (e in emitters) {
		e.timer -= elapsed;
		if (e.timer <= 0) {
			e.timer = FlxG.random.float(e.gapMin, e.gapMax);
			spawnNote(e);
		}
	}

	for (i in 0...notePool.length) {
		var note = notePool[i];
		if (!note.visible) continue;

		noteAge[i] += elapsed;
		var t = noteAge[i] / noteLife[i];
		if (t >= 1) {
			note.visible = false;
			continue;
		}

		var sway = Math.sin(noteAge[i] * noteSwayRate[i] + notePhase[i]) * noteSway[i];
		note.x += (noteVx[i] + sway) * elapsed;
		note.y += noteVy[i] * elapsed;
		noteVy[i] *= 1 - 0.18 * elapsed; // slows a little as it rises
		note.angle = Math.sin(noteAge[i] * 1.7 + notePhase[i]) * 16;

		// Fade in quickly, hold, fade out over the last 40 %; grow slightly as it rises.
		var fade = t < 0.12 ? t / 0.12 : (t > 0.6 ? (1 - t) / 0.4 : 1.0);
		note.alpha = 0.95 * fade;
		var size = noteScale[i] * (0.9 + 0.2 * t);
		note.scale.set(size, size);
	}
}

// ACCEPT during the intro: put everything in its final place at once.
function skipIntro() {
	for (timer in introTimers) timer.cancel();
	introTimers = [];

	sketch.animation.play('loop');

	for (i in 0...buttons.length) {
		FlxTween.cancelTweensOf(buttons[i]);
		FlxTween.cancelTweensOf(buttonLabels[i]);
		FlxTween.cancelTweensOf(buttonShadows[i]);
		buttons[i].x = buttonX;
		buttonLabels[i].x = buttonX;
		buttonShadows[i].x = buttonX + labelShadow;
	}

	for (sprite in [folder, vinyl, vinylPencil]) {
		FlxTween.cancelTweensOf(sprite.scale);
		sprite.scale.set(1, 1);
	}

	onLanded();
	finishIntro();
}

function finishIntro() {
	if (introDone) return;
	introDone = true;
	updateHighlight();
}

// ---------------------------------------------------------------- selection

function updateHighlight() {
	for (i in 0...buttons.length) {
		var active = focus == "stack" && i == selectedIndex;

		// Selected plays the pulsing cyan glow of the button sheet; the others show the plain button.
		if (active) {
			buttons[i].animation.play('glow');
		} else {
			buttons[i].animation.stop();
			buttons[i].animation.frameIndex = 0;
		}

		// The slide shift only runs once the intro is over; it would fight the slide-in.
		if (introDone) {
			FlxTween.cancelTweensOf(buttons[i]);
			FlxTween.cancelTweensOf(buttonLabels[i]);
			FlxTween.cancelTweensOf(buttonShadows[i]);
			var targetX = buttonX + (active ? selectedShift : 0);
			FlxTween.tween(buttons[i], {x: targetX}, 0.15, {ease: FlxEase.quadOut});
			FlxTween.tween(buttonLabels[i], {x: targetX}, 0.15, {ease: FlxEase.quadOut});
			FlxTween.tween(buttonShadows[i], {x: targetX + labelShadow}, 0.15, {ease: FlxEase.quadOut});
		}
	}

	// Focus on the folder shows only as a bigger icon.
	if (introDone) {
		var folderActive = focus == "folder";
		FlxTween.cancelTweensOf(folder.scale);
		FlxTween.tween(folder.scale, {x: folderActive ? 1.15 : 1, y: folderActive ? 1.15 : 1}, 0.15);
	}
}

function moveSelection(delta:Int) {
	focus = "stack";
	selectedIndex = (selectedIndex + delta + buttonKeys.length) % buttonKeys.length;
	updateHighlight();
}

function setFocus(value:String) {
	focus = value;
	updateHighlight();
}

function confirmSelection() {
	if (focus == "folder") {
		// The art gallery does not exist yet: nothing to open, only a small nudge.
		trace("[MainMenu] folder pressed: gallery not built yet");
		FlxTween.cancelTweensOf(folder);
		folder.y = folderRestY;
		FlxTween.tween(folder, {y: folderRestY - 6}, 0.07, {ease: FlxEase.quadOut, onComplete: (_) -> FlxTween.tween(folder, {y: folderRestY}, 0.09)});
		return;
	}

	switch (buttonKeys[selectedIndex]) {
		case "PLAY": FlxG.switchState(new ModState("EchoSelectState"));
		case "SETTINGS": FlxG.switchState(new ModState("OptionsState"));
		case "CREDITS": FlxG.switchState(new CreditsMain());
	}
}

// Hover only counts while the mouse actually moves: a pointer resting on a button must not
// undo what the keyboard just selected.
function updateMouse() {
	var moved = FlxG.mouse.screenX != lastMouseX || FlxG.mouse.screenY != lastMouseY;
	lastMouseX = FlxG.mouse.screenX;
	lastMouseY = FlxG.mouse.screenY;

	var overFolder = FlxG.mouse.overlaps(folder);

	if (moved) {
		if (overFolder && focus != "folder") setFocus("folder");

		for (i in 0...buttons.length) {
			if (FlxG.mouse.overlaps(buttons[i]) && (focus != "stack" || selectedIndex != i)) {
				focus = "stack";
				selectedIndex = i;
				updateHighlight();
			}
		}
	}

	if (FlxG.mouse.justPressed && (overFolder || (focus == "stack" && FlxG.mouse.overlaps(buttons[selectedIndex]))))
		confirmSelection();
}

function update(elapsed) {
	// The record spins while the music plays.
	if (landed && FlxG.sound.music != null && FlxG.sound.music.playing && vinyl.animation.curAnim == null)
		vinyl.animation.play('spin');

	updateParticles(elapsed);

	if (controls.UP_P) moveSelection(-1);
	else if (controls.DOWN_P) {
		if (focus == "folder") setFocus("stack");
		else moveSelection(1);
	}

	if (controls.RIGHT_P && focus == "stack") setFocus("folder");
	else if (controls.LEFT_P && focus == "folder") setFocus("stack");

	updateMouse();

	if (controls.ACCEPT) {
		if (introDone) confirmSelection();
		else skipIntro();
	}

	if (controls.BACK)
		FlxG.switchState(new TitleState());
}

function destroy() {
	FlxG.mouse.visible = false;
}
