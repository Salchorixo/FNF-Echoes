import flixel.FlxSprite;
import flixel.group.FlxGroup;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import funkin.backend.scripting.ModState;
import funkin.backend.scripting.Script;
import openfl.display.BlendMode;

// Echo selection (the screen after PLAY): three portrait windows in the common language of the menus
// (BE-14): Windows Vista glass in pixel art with a pencil outline, on a dark Frutiger Aero night (BE-23). Only Echo 1
// is playable (a healthy, active window). Echo 2 is dim and held shut by rusty chains; Echo 3 is dim,
// broken, and ink spills out of the break. Echo 2 and 3 are reserved for a future full version of the
// mod. The art is generated by AI_export_echo_vista.py (private art folder): the native 96x128 window
// at 3x with no smoothing, so every pixel has the same size, with the pencil rectangle already drawn
// over it (so the outline moves with the window). Every cell is 348x498 px with a 24 px margin of
// pencil overshoot; the window is at (24, 24) and is 288x384. The old XP art (card_1, chains,
// glitch) stays in images/menus/echo/ for the future XP theme.
//
// There are no labels: the windows' own title bars say "ECHO 1/2/3" ("ECHO" is never translated).
// No VHS shader here, same as the main menu (Zyra's call: no filters for now, and pixel art must
// stay crisp). Up/left/right move the selection (the selected window lifts a little), ACCEPT opens
// Echo 1 and makes a locked window shake. The mouse works too (hover selects, a click confirms) and the windows
// can be DRAGGED (BE-22): grab one anywhere and it lifts (a soft shadow appears, it tilts a little with the
// movement); where you drop it, it bounces and stays (cardBaseX/cardHomeY are its new home until you leave the
// screen). A press that does not move is a click, not a drag. Locked windows can be dragged too, they just do not open.
// While you drag, the window leaves a TRAIL of copies of itself along the way, like the windows of the old systems when
// they hung (ghosts: a pool of sprites); the trail fades away when you drop it. The window you grab, and the selected
// one, come to the FRONT of the others (raise()).
//
// THEMES (BE-30): the frame of the windows (title bar, buttons, border) follows the desktop theme (Vista, XP, Windows 98, Mac):
// the sheets are <theme>_echo_1 / _chains / _glitch (and bg/refl_<theme>_*), made by AI_export_window_themes.py. The theme is read
// once, when the screen opens: it never changes while you are here.
//
// BACKGROUND (BE-23, mockup AI_build_echo_bg_v4.py): a dark night made of planes at different distances (haze, light shafts, a far
// city, four rolling waves, fog, floating windows and folders, bubbles, dust motes, huge out-of-focus frames in front). Every plane
// is an image baked by AI_export_echo_bg.py (images/menus/echo/bg/) and moved here with sines; when the selection changes the
// planes slide at different speeds (parallax "dolly"). Under the windows there is a glass FLOOR that reflects them (the reflections
// are baked flipped, blurred and faded) and a water ripple spreads under the window that was just selected. The light comes OUT OF
// each window: a glow (soft radial light + a rim light shaped like the window) that is brighter on the selected window and
// travels with it, also while it is dragged. The selected window is bigger and bright; the others are smaller and dimmer.
// The layers live in groups (bgGroup, floorGroup, glowGroup, cardGroup, fgGroup) so raise() only reorders the windows.

var echoUnlocked:Array<Bool> = [true, false, false];
var cards:Array<FlxSprite> = [];
var cardBaseX:Array<Float> = [];
var cardBaseY:Float = 0;
var cardHomeY:Array<Float> = [];
var selectedIndex:Int = 0;

var windowW:Float = 288;
var windowH:Float = 384;
var cellW:Int = 348;
var cellH:Int = 498;
var cellMargin:Float = 24;
var cardGap:Float = 56;
var cardRaise:Float = 22; // how far above the centre the windows sit (room for the ink puddle)
var liftHeight:Float = 12;

// Dragging (BE-22)
var dragIndex:Int = -1;
var dragMoved:Bool = false;
var dragOffX:Float = 0;
var dragOffY:Float = 0;
var dragStartX:Float = 0;
var dragStartY:Float = 0;
var dragLift:Float = 22;
var dragState:Dynamic = {lift: 0.0};
var dragShadow:FlxSprite;
var ghosts:Array<FlxSprite> = [];
var ghostNext:Int = 0;
var ghostPool:Int = 24;
var ghostSpacing:Float = 26; // pixels of movement between two copies
var lastGhostX:Float = 0;
var lastGhostY:Float = 0;

// Animations: Echo 2's chains are 32 frames, Echo 3's glitch 64; pixel art steps at 10 fps.
var chainsFrames:Int = 32;
var glitchFrames:Int = 64;
var animFps:Float = 10;

// Entrance: the windows rise into place one after another, with a small overshoot.
var openStagger:Float = 0.14;
var openTime:Float = 0.45;
var opened:Bool = false;

// Guards against the key press that opened this state still being
// "justPressed" on this state's very first update() — without this, the
// same physical ACCEPT press that confirmed "PLAY" on the previous menu
// would immediately confirm a card here too.
var canConfirm:Bool = false;

var lastMouseX:Float = -1;
var lastMouseY:Float = -1;

// Background (BE-23)
var bgDir:String = 'menus/echo/bg/';
var theme:String = "vista";
var bgGroup:FlxGroup;
var floorGroup:FlxGroup;
var glowGroup:FlxGroup;
var cardGroup:FlxGroup;
var fgGroup:FlxGroup;
var time:Float = 0;
var floorY:Float = 0; // the line the windows stand on (their reflections start here)
var dolly:Float = 0; // how far the planes are pushed sideways by the selection
var selW:Array<Float> = [0, 0, 0]; // how selected each window is (0..1), eased
var ambR:Array<Int> = [255, 120, 60]; // the light of each Echo: warm, blue, deep blue
var ambG:Array<Int> = [190, 170, 100];
var ambB:Array<Int> = [110, 255, 255];
var items:Array<Dynamic> = []; // floaters, bubbles, dust motes
var waveLayers:Array<Dynamic> = [];
var sheens:Array<Dynamic> = [];
var bgHaze:FlxSprite;
var bgBeams:FlxSprite;
var bgSky:FlxSprite;
var bgFog:FlxSprite;
var bgNear:FlxSprite;
var bgTint:FlxSprite;
var floorGlow:FlxSprite;
var glowRadial:Array<FlxSprite> = [];
var glowRim:Array<FlxSprite> = [];
var reflections:Array<FlxSprite> = [];
var contacts:Array<FlxSprite> = [];
var ripples:Array<FlxSprite> = [];
var rippleNext:Int = 0;
var lastRippleIndex:Int = 0;

function create() {
	FlxG.camera.scroll.set(0, 0); // every screen resets its own camera
	bgColor = FlxColor.BLACK;
	var themer = Script.create(Paths.script('scripts/ui/themeManager'));
	themer.load();
	theme = themer.call("current"); // the windows' frame follows the desktop theme (BE-30)
	floorY = (FlxG.height - windowH) / 2 - cardRaise + windowH + 8;

	bgGroup = new FlxGroup();
	floorGroup = new FlxGroup();
	glowGroup = new FlxGroup();
	cardGroup = new FlxGroup();
	fgGroup = new FlxGroup();
	add(bgGroup);
	add(floorGroup);
	add(glowGroup);
	add(cardGroup);
	add(fgGroup);

	buildBackground();
	buildFloor();
	buildGlow();
	buildShadow();
	buildGhosts();
	buildCards();
	buildForeground();

	FlxG.mouse.visible = true;
	// Start from where the pointer already is, so a mouse resting on a window at entry does not count
	// as hover (it would override the keyboard selection on the very first frame).
	lastMouseX = FlxG.mouse.screenX;
	lastMouseY = FlxG.mouse.screenY;
	new FlxTimer().start(0.2, (_) -> canConfirm = true);
	new FlxTimer().start(openStagger * 2 + openTime, (_) -> finishOpening());
}

function buildCards() {
	var startX = (FlxG.width - (3 * windowW + 2 * cardGap)) / 2;
	cardBaseY = (FlxG.height - windowH) / 2 - cardRaise;

	for (i in 0...3) {
		var card = new FlxSprite();
		if (i == 0) {
			card.loadGraphic(Paths.image('menus/echo/' + theme + '_echo_1'));
		} else {
			card.loadGraphic(Paths.image('menus/echo/' + theme + (i == 1 ? '_echo_chains' : '_echo_glitch')), true, cellW, cellH);
			var frames = i == 1 ? chainsFrames : glitchFrames;
			card.animation.add('loop', [for (f in 0...frames) f], animFps, true);
			card.animation.play('loop');
		}
		card.antialiasing = false;
		// The sprite carries a margin of pencil overshoot: its hitbox is just the window.
		card.width = windowW;
		card.height = windowH;
		card.offset.set(cellMargin, cellMargin);
		card.origin.set(cellMargin + windowW / 2, cellMargin + windowH / 2); // it scales and tilts around the window's centre

		var x = startX + i * (windowW + cardGap);
		cardBaseX.push(x);
		cardHomeY.push(cardBaseY);
		card.setPosition(x, cardBaseY + 48);
		card.alpha = 0;
		cardGroup.add(card);
		cards.push(card);

		var index = i;
		new FlxTimer().start(index * openStagger, (_) -> {
			FlxTween.tween(card, {y: cardHomeY[index]}, openTime, {ease: FlxEase.backOut});
			FlxTween.tween(card, {alpha: 1}, 0.25);
		});
	}
}

// A soft ellipse that appears under a window while it is dragged.
function buildShadow() {
	var w = 256;
	var h = 64;
	dragShadow = new FlxSprite();
	dragShadow.makeGraphic(w, h, FlxColor.TRANSPARENT, true, "echoesDragShadow");
	for (y in 0...h) {
		for (x in 0...w) {
			var dx = (x - w / 2) / (w / 2);
			var dy = (y - h / 2) / (h / 2);
			var d = Math.sqrt(dx * dx + dy * dy);
			dragShadow.pixels.setPixel32(x, y, FlxColor.fromRGB(40, 60, 90, Std.int(120 * Math.pow(Math.max(0, 1 - d), 1.4))));
		}
	}
	dragShadow.dirty = true;
	dragShadow.antialiasing = true;
	dragShadow.alpha = 0;
	cardGroup.add(dragShadow);
}

// The pool of copies that make the trail. They take the picture of the window that is dragged (see spawnGhost()).
function buildGhosts() {
	for (i in 0...ghostPool) {
		var ghost = new FlxSprite();
		ghost.antialiasing = false;
		ghost.visible = false;
		cardGroup.add(ghost);
		ghosts.push(ghost);
	}
}

// A copy of the window as it is now, left behind on the path.
function spawnGhost(card:FlxSprite) {
	var ghost = ghosts[ghostNext];
	ghostNext = (ghostNext + 1) % ghostPool;
	FlxTween.cancelTweensOf(ghost);
	ghost.frames = card.frames;
	ghost.animation.frameIndex = card.animation.frameIndex;
	ghost.width = windowW;
	ghost.height = windowH;
	ghost.offset.set(cellMargin, cellMargin);
	ghost.origin.set(cellMargin + windowW / 2, cellMargin + windowH / 2);
	ghost.scale.set(card.scale.x, card.scale.y);
	ghost.color = card.color;
	ghost.angle = card.angle;
	ghost.setPosition(card.x, card.y);
	ghost.alpha = 0.55;
	ghost.visible = true;
	lastGhostX = card.x;
	lastGhostY = card.y;
}

function fadeGhosts() {
	for (ghost in ghosts) {
		if (!ghost.visible) continue;
		var g = ghost;
		FlxTween.tween(g, {alpha: 0}, 0.35, {onComplete: (_) -> g.visible = false});
	}
}

// Put a window above the others (the later in the list, the higher).
function raise(i:Int) {
	cardGroup.remove(cards[i], true); // splice: without it the slot is reused and the order does not change
	cardGroup.add(cards[i]);
}

function finishOpening() {
	opened = true;
	updateSelection();
}

// The selected window lifts a little; the others sit at their base. Waits for the entrance to end
// so the two tweens do not fight.
function updateSelection() {
	if (!opened) return;
	if (dragIndex < 0) raise(selectedIndex);
	if (selectedIndex != lastRippleIndex) {
		lastRippleIndex = selectedIndex;
		spawnRipple(selectedIndex);
	}

	for (i in 0...cards.length) {
		if (i == dragIndex) continue;
		FlxTween.cancelTweensOf(cards[i], ["y"]);
		var targetY = cardHomeY[i] - (i == selectedIndex ? liftHeight : 0);
		FlxTween.tween(cards[i], {y: targetY}, 0.12, {ease: FlxEase.quadOut});
	}
}

function moveSelection(delta:Int) {
	selectedIndex = (selectedIndex + delta + cards.length) % cards.length;
	updateSelection();
}

// A locked window refuses: a quick horizontal shake that dies down.
function shake(index:Int) {
	var card = cards[index];
	var baseX = cardBaseX[index];
	new FlxTimer().start(0.035, (t) -> {
		card.x = t.loopsLeft == 0 ? baseX : baseX + (t.elapsedLoops % 2 == 0 ? -7 : 7) * (t.loopsLeft / 8);
	}, 8);
}

function confirmSelection() {
	if (!canConfirm || !opened)
		return;

	if (!echoUnlocked[selectedIndex]) {
		shake(selectedIndex);
		return;
	}

	FlxG.switchState(new ModState("StoryMapState"));
}

// Hover only counts while the mouse actually moves: a pointer resting on a window must not undo
// what the keyboard just selected.
function updateMouse() {
	var moved = FlxG.mouse.screenX != lastMouseX || FlxG.mouse.screenY != lastMouseY;
	lastMouseX = FlxG.mouse.screenX;
	lastMouseY = FlxG.mouse.screenY;

	if (moved && opened && dragIndex < 0) {
		for (i in 0...cards.length) {
			if (i != selectedIndex && FlxG.mouse.overlaps(cards[i])) {
				selectedIndex = i;
				updateSelection();
			}
		}
	}

}

// ---------------------------------------------------------------- dragging

function clamp(v:Float, lo:Float, hi:Float):Float {
	return Math.max(lo, Math.min(hi, v));
}

function beginDrag(i:Int, mx:Float, my:Float) {
	var card = cards[i];
	dragIndex = i;
	dragMoved = false;
	dragStartX = mx;
	dragStartY = my;
	dragOffX = mx - card.x;
	dragOffY = my - card.y;
	selectedIndex = i;
	FlxTween.cancelTweensOf(card);
	FlxTween.cancelTweensOf(card, ["angle"]);
	card.alpha = 1;
	// on top of the other windows, with its trail and its shadow just below it
	for (ghost in ghosts) {
		FlxTween.cancelTweensOf(ghost);
		ghost.visible = false;
		cardGroup.remove(ghost, true);
		cardGroup.add(ghost);
	}
	cardGroup.remove(dragShadow, true);
	cardGroup.add(dragShadow);
	raise(i);
	lastGhostX = card.x;
	lastGhostY = card.y;
	updateSelection();
}

// The press turned into a drag: the window lifts and its shadow fades in.
function liftCard() {
	FlxTween.cancelTweensOf(dragState);
	FlxTween.tween(dragState, {lift: dragLift}, 0.1, {ease: FlxEase.quadOut});
	FlxTween.cancelTweensOf(dragShadow);
	FlxTween.tween(dragShadow, {alpha: 1}, 0.1);
}

function endDrag() {
	var i = dragIndex;
	var card = cards[i];
	dragIndex = -1;

	if (!dragMoved) {
		// no movement: it was a click
		selectedIndex = i;
		updateSelection();
		confirmSelection();
		return;
	}

	// drop: the trail fades; it falls the lift it had, bounces, straightens up and stays here
	fadeGhosts();
	cardBaseX[i] = card.x;
	cardHomeY[i] = card.y + dragState.lift;
	FlxTween.cancelTweensOf(dragState);
	FlxTween.tween(dragState, {lift: 0.0}, 0.3, {ease: FlxEase.bounceOut});
	FlxTween.tween(card, {y: cardHomeY[i]}, 0.32, {ease: FlxEase.bounceOut, onComplete: (_) -> {
		FlxTween.tween(dragShadow, {alpha: 0}, 0.15);
		updateSelection();
	}});
	FlxTween.tween(card, {angle: 0}, 0.4, {ease: FlxEase.elasticOut});
}

function updateDrag(elapsed:Float) {
	var mx = FlxG.mouse.screenX;
	var my = FlxG.mouse.screenY;

	if (dragIndex < 0) {
		if (FlxG.mouse.justPressed && opened && canConfirm) {
			// the topmost window under the pointer (later windows are drawn above the earlier ones)
			var hit = -1;
			for (i in 0...cards.length)
				if (FlxG.mouse.overlaps(cards[i]))
					hit = i;
			if (hit >= 0)
				beginDrag(hit, mx, my);
		}
		// the shadow keeps following the window that was just dropped
		if (dragShadow.alpha > 0) {
			var dropped = selectedIndex;
			placeShadow(cards[dropped], dragState.lift);
		}
		return;
	}

	var card = cards[dragIndex];
	if (FlxG.mouse.pressed) {
		if (!dragMoved && (Math.abs(mx - dragStartX) > 6 || Math.abs(my - dragStartY) > 6)) {
			dragMoved = true;
			liftCard();
		}
		if (dragMoved) {
			var targetX = clamp(mx - dragOffX, 0, FlxG.width - windowW);
			var targetY = clamp(my - dragOffY, 0, FlxG.height - windowH);
			var follow = Math.min(1, elapsed * 40);
			var oldX = card.x;
			card.x += (targetX - card.x) * follow;
			card.y += (targetY - dragState.lift - card.y) * follow;
			// it tilts a little with the horizontal movement
			var tilt = clamp((card.x - oldX) * 0.9, -6, 6);
			card.angle += (tilt - card.angle) * Math.min(1, elapsed * 14);
			placeShadow(card, dragState.lift);
			if (Math.abs(card.x - lastGhostX) + Math.abs(card.y - lastGhostY) >= ghostSpacing)
				spawnGhost(card);
		}
	} else {
		endDrag();
	}
}

// The shadow lies under the window's base, wider and fainter the higher the window is.
function placeShadow(card:FlxSprite, lift:Float) {
	var width = windowW * (0.95 + 0.003 * lift);
	dragShadow.scale.set(width / 256, 0.55 + lift * 0.004);
	dragShadow.updateHitbox();
	dragShadow.setPosition(card.x + windowW / 2 - dragShadow.width / 2, card.y + lift + windowH - dragShadow.height / 2 + 6);
}

// ---------------------------------------------------------------- background (BE-23)

// Modulo that also works for negative numbers.
function wrap(v:Float, m:Float):Float {
	var r = v % m;
	return r < 0 ? r + m : r;
}

// A full-size layer from images/menus/echo/bg/. additive = true draws it with ADD blend (black is nothing).
function mk(name:String, group:FlxGroup, additive:Bool):FlxSprite {
	var spr = new FlxSprite();
	spr.loadGraphic(Paths.image(bgDir + name));
	spr.antialiasing = true;
	if (additive)
		spr.blend = BlendMode.ADD;
	group.add(spr);
	return spr;
}

// Floating window or folder far away (level 0) or at mid distance (level 1): it rises slowly.
function addFloater(level:Int) {
	var z = level == 0 ? 0.25 : 0.6;
	var spr = mk((FlxG.random.bool(55) ? 'floater_win_' : 'floater_fold_') + level, bgGroup, false);
	var sc = FlxG.random.float(18, 40) * (0.55 + 0.85 * z) / 52;
	spr.scale.set(sc, sc);
	spr.alpha = level == 0 ? 0.55 : 1.0;
	items.push({spr: spr, kind: 'floater', x: FlxG.random.float(-60, FlxG.width + 60), y: FlxG.random.float(0, FlxG.height), speed: FlxG.random.float(3, 9), ph: FlxG.random.float(0, 1), z: z, s: sc});
}

// Bubble at three distances (0 far, 1 mid, 2 near: the near ones are big, blurred and in front of the windows).
function addBubble(level:Int, group:FlxGroup) {
	var z = [0.3, 0.6, 1.2][level];
	var spr = mk('bubble_' + level, group, false);
	var sc = FlxG.random.float(0.8, 1.35);
	spr.scale.set(sc, sc);
	items.push({spr: spr, kind: 'bubble', x: FlxG.random.float(-20, FlxG.width + 20), y: FlxG.random.float(0, FlxG.height + 120), speed: [10, 22, 46][level] * FlxG.random.float(0.8, 1.2), sway: [6, 10, 18][level], ph: FlxG.random.float(0, 1), z: z, s: sc});
}

function buildBackground() {
	mk('base', bgGroup, false);
	bgHaze = mk('haze', bgGroup, true);
	for (i in 0...8)
		addFloater(0);
	for (i in 0...9)
		addBubble(0, bgGroup);
	bgBeams = mk('beams', bgGroup, true);
	bgSky = mk('skyline', bgGroup, false);
	// four rolling waves: each strip tiles every 1280 px, so two copies side by side scroll forever
	for (k in 0...4) {
		var a = mk('wave_' + k, bgGroup, false);
		var b = mk('wave_' + k, bgGroup, false);
		waveLayers.push({a: a, b: b, speed: [10, 16, 26, 38][k], z: [0.2, 0.4, 0.7, 1.0][k]});
	}
	bgFog = mk('fog', bgGroup, true);
	for (i in 0...12)
		addFloater(1);
	for (i in 0...9)
		addBubble(1, bgGroup);
	// dust that glitters inside the light shafts
	for (i in 0...40) {
		var mote = mk('mote', bgGroup, false);
		var sc = FlxG.random.getObject([1, 2, 2, 3]) / 2.5;
		mote.scale.set(sc, sc);
		items.push({spr: mote, kind: 'mote', x: FlxG.random.float(0, 1000), y: FlxG.random.float(0, FlxG.height), speed: FlxG.random.float(4, 12), ph: FlxG.random.float(0, 1)});
	}
	// a soft colour grade of the whole scene toward the selected Echo's light
	bgTint = new FlxSprite();
	bgTint.makeGraphic(FlxG.width, FlxG.height, FlxColor.WHITE);
	bgTint.alpha = 0.07;
	bgGroup.add(bgTint);
}

// The glass floor: a glow that fades with distance, light streaks that drift, a contact shadow and the reflection of each window,
// and the pool of water rings.
function buildFloor() {
	floorGlow = mk('floor_glow', floorGroup, true);
	floorGlow.y = floorY;
	floorGlow.alpha = 0.6;
	for (k in 0...5) {
		var sh = mk('sheen_' + (k % 3), floorGroup, true);
		sh.alpha = 0.8;
		sheens.push({spr: sh, k: k});
	}
	for (i in 0...3) {
		var con = new FlxSprite();
		if (i == 0) {
			var w = 256;
			var h = 64;
			con.makeGraphic(w, h, FlxColor.TRANSPARENT, true, "echoesContactShadow");
			for (y in 0...h) {
				for (x in 0...w) {
					var dx = (x - w / 2) / (w / 2);
					var dy = (y - h / 2) / (h / 2);
					var d = Math.sqrt(dx * dx + dy * dy);
					con.pixels.setPixel32(x, y, FlxColor.fromRGB(0, 6, 20, Std.int(150 * Math.pow(Math.max(0, 1 - d), 1.2))));
				}
			}
			con.dirty = true;
		} else {
			con.loadGraphicFromSprite(contacts[0]);
		}
		con.antialiasing = true;
		con.alpha = 0;
		floorGroup.add(con);
		contacts.push(con);
	}
	for (i in 0...3) {
		var refl = new FlxSprite();
		if (i == 0) {
			refl.loadGraphic(Paths.image(bgDir + 'refl_' + theme + '_1'));
		} else {
			refl.loadGraphic(Paths.image(bgDir + 'refl_' + theme + (i == 1 ? '_chains' : '_glitch')), true, cellW, 200);
		}
		refl.antialiasing = true;
		refl.origin.set(cellMargin + windowW / 2, 0); // it scales from its top, where it touches the window's base
		refl.alpha = 0;
		floorGroup.add(refl);
		reflections.push(refl);
	}
	for (i in 0...6) {
		var ring = mk('ripple', floorGroup, true);
		ring.alpha = 0;
		ripples.push(ring);
	}
}

// The light that comes out of each window: a soft radial light and a rim light shaped like the window.
function buildGlow() {
	for (i in 0...3) {
		var color = FlxColor.fromRGB(ambR[i], ambG[i], ambB[i]);
		var rad = mk('glow_radial', glowGroup, true);
		rad.color = color;
		rad.alpha = 0;
		glowRadial.push(rad);
		var rim = mk('glow_rim', glowGroup, false);
		rim.color = color;
		rim.alpha = 0;
		glowRim.push(rim);
	}
}

// In front of the windows: big blurred bubbles, huge dark frames at the edges, and the vignette.
function buildForeground() {
	for (i in 0...8)
		addBubble(2, fgGroup);
	bgNear = mk('near', fgGroup, false);
	mk('vignette', fgGroup, false);
}

// A ring of water spreads on the floor under the window that was just selected (two rings, one after the other).
function spawnRipple(i:Int) {
	var cx = cards[i].x + windowW / 2;
	var color = FlxColor.fromRGB(Std.int(Math.min(255, ambR[i] + 60)), Std.int(Math.min(255, ambG[i] + 60)), Std.int(Math.min(255, ambB[i] + 60)));
	for (ring in 0...2) {
		var r = ripples[rippleNext];
		rippleNext = (rippleNext + 1) % ripples.length;
		FlxTween.cancelTweensOf(r);
		FlxTween.cancelTweensOf(r.scale);
		r.alpha = 0;
		new FlxTimer().start(ring * 0.18, (_) -> {
			r.color = color;
			r.setPosition(cx - 300, floorY + 4 - 40);
			r.scale.set(0.23, 0.23);
			r.alpha = 0.7;
			FlxTween.tween(r.scale, {x: 1.0, y: 1.0}, 0.9, {ease: FlxEase.quadOut});
			FlxTween.tween(r, {alpha: 0}, 0.9, {ease: FlxEase.quadIn});
		});
	}
}

// Moves every plane. The selection pushes the planes sideways by different amounts (parallax): the nearer, the more.
function updateBackground(elapsed:Float) {
	time += elapsed;
	var target = dragIndex >= 0 ? dragIndex : selectedIndex;
	var follow = Math.min(1, elapsed * 9);
	dolly = 0;
	for (i in 0...3) {
		selW[i] += ((i == target ? 1 : 0) - selW[i]) * follow;
		dolly += selW[i] * (1 - i) * 36;
	}
	var sum = Math.max(0.01, selW[0] + selW[1] + selW[2]);
	var cr = 0.0;
	var cg = 0.0;
	var cb = 0.0;
	for (i in 0...3) {
		cr += selW[i] * ambR[i] / sum;
		cg += selW[i] * ambG[i] / sum;
		cb += selW[i] * ambB[i] / sum;
	}
	var amb = FlxColor.fromRGB(Std.int(cr), Std.int(cg), Std.int(cb));
	bgTint.color = amb;
	floorGlow.color = amb;

	bgHaze.x = dolly * 0.1 + 12 * Math.sin(time * 0.2);
	bgBeams.x = dolly * 0.15;
	bgBeams.alpha = 0.86 + 0.14 * Math.sin(time * 1.4);
	bgSky.x = dolly * 0.2;
	bgSky.alpha = 0.8 + 0.2 * Math.sin(time * 0.7);
	bgFog.x = dolly * 0.2 + 50 * Math.sin(time * 0.12);
	bgNear.x = -120 + dolly * 1.6 + 16 * Math.sin(time * 0.25);
	bgNear.y = 12 * Math.sin(time * 0.2);
	for (wl in waveLayers) {
		var x = -wrap(time * wl.speed - dolly * wl.z, FlxG.width);
		wl.a.x = x;
		wl.b.x = x + FlxG.width;
	}
	for (sh in sheens) {
		sh.spr.x = wrap(sh.k * 331 + time * (14 + 5 * sh.k), FlxG.width + 600) - 300;
		sh.spr.y = floorY + 14 + sh.k * 30 + 6 * Math.sin(time * 0.8 + sh.k) - 20;
	}
	for (item in items) {
		var spr = item.spr;
		if (item.kind == 'floater') {
			spr.x = item.x + dolly * item.z + 14 * Math.sin(time * 0.3 + item.ph * 6) - spr.frameWidth / 2;
			spr.y = wrap(item.y - time * item.speed * (0.6 + item.z), FlxG.height + 160) - 80 - spr.frameHeight / 2;
		} else if (item.kind == 'bubble') {
			var pulse = item.s * (1 + 0.05 * Math.sin(time * 2.1 + item.ph * 9));
			spr.scale.set(pulse, pulse);
			spr.x = item.x + dolly * item.z + item.sway * Math.sin(time * 0.9 + item.ph * 6.3) - spr.frameWidth / 2;
			spr.y = wrap(item.y - time * item.speed, FlxG.height + 140) - 70 - spr.frameHeight / 2;
		} else {
			var y = wrap(item.y - time * item.speed, FlxG.height);
			var x = item.x + dolly * 0.4 + 10 * Math.sin(time * 0.6 + item.ph * 6);
			spr.visible = x <= y * 1.25 + 380 && x >= y * 0.15 - 40; // only inside the shafts of light
			spr.x = x - 5;
			spr.y = y - 5;
			spr.alpha = (60 + 170 * (0.5 + 0.5 * Math.sin(time * 3 + item.ph * 12))) / 255;
		}
	}
}

// Everything that hangs on a window follows it: its size and brightness, its glow, its reflection and its contact shadow.
// The selected window is bigger and bright; the others are smaller and dimmer.
function syncCards() {
	for (i in 0...cards.length) {
		var card = cards[i];
		var w = selW[i];
		var sc = 0.93 + 0.11 * w;
		card.scale.set(sc, sc);
		var k = Std.int(255 * (0.52 + 0.48 * w));
		card.color = FlxColor.fromRGB(k, k, k);
		var cx = card.x + windowW / 2;
		var cy = card.y + windowH / 2;
		var vis = card.alpha;

		var rad = glowRadial[i];
		rad.setPosition(cx - rad.frameWidth / 2, cy - rad.frameHeight / 2);
		rad.scale.set(sc, sc);
		rad.alpha = 0.38 * w * vis;
		var rim = glowRim[i];
		rim.setPosition(cx - rim.frameWidth / 2, cy - rim.frameHeight / 2);
		rim.scale.set(sc, sc);
		rim.angle = card.angle;
		rim.alpha = 0.7 * w * vis;

		var bottom = cy + windowH / 2 * sc;
		var refl = reflections[i];
		refl.visible = bottom < floorY + 20;
		if (i > 0)
			refl.animation.frameIndex = card.animation.frameIndex;
		refl.scale.set(sc, sc);
		refl.angle = -card.angle;
		refl.color = card.color;
		refl.alpha = (0.5 + 0.5 * w) * vis;
		refl.setPosition(cx - (cellMargin + windowW / 2), 2 * floorY - bottom);

		var con = contacts[i];
		con.scale.set(windowW * sc / 256, 0.45);
		con.alpha = (0.55 + 0.35 * w) * Math.max(0.15, 1 - Math.max(0, floorY - bottom) / 260) * vis;
		con.setPosition(cx - con.frameWidth / 2, floorY - con.frameHeight / 2 + 4);
	}
}

function update(elapsed) {
	if (controls.LEFT_P)
		moveSelection(-1);
	else if (controls.RIGHT_P)
		moveSelection(1);

	updateDrag(elapsed);
	updateMouse();
	updateBackground(elapsed);
	syncCards();

	if (controls.ACCEPT)
		confirmSelection();

	if (controls.BACK)
		FlxG.switchState(new ModState("MainMenuState"));
}

function destroy() {
	FlxG.mouse.visible = false;
}
