import flixel.FlxSprite;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;
import flixel.util.FlxTimer;
import funkin.backend.scripting.ModState;

// Echo selection (the screen after PLAY): three portrait windows in the common language of the menus
// (BE-14): Windows Vista glass in pixel art with a pencil outline, on a white background. Only Echo 1
// is playable (a healthy, active window). Echo 2 is dim and held shut by rusty chains; Echo 3 is dim,
// broken, and ink spills out of the break. Echo 2 and 3 are reserved for a future full version of the
// mod. The art is generated by AI_export_echo_vista.py (private art folder): the native 96x128 window
// at 3x with no smoothing, so every pixel has the same size, with the pencil rectangle already drawn
// over it (so the outline moves with the window). Every cell is 348x498 px with a 24 px margin of
// pencil overshoot; the window is at (24, 24) and is 288x384. The old XP art (card_1, chains,
// glitch) stays in images/menus/echo/ for the future XP theme.
//
// There are no labels: the windows' own title bars say "ECHO 1/2/3" ("ECHO" is never translated).
// No VHS shader here, same as the main menu (Zyra's call: no filters for now, and pixel art must
// stay crisp). Up/left/right move the selection (the selected window lifts a little), ACCEPT opens
// Echo 1 and makes a locked window shake. The mouse works too (hover selects, click confirms).

var echoUnlocked:Array<Bool> = [true, false, false];
var cards:Array<FlxSprite> = [];
var cardBaseX:Array<Float> = [];
var cardBaseY:Float = 0;
var selectedIndex:Int = 0;

var windowW:Float = 288;
var windowH:Float = 384;
var cellW:Int = 348;
var cellH:Int = 498;
var cellMargin:Float = 24;
var cardGap:Float = 56;
var cardRaise:Float = 22; // how far above the centre the windows sit (room for the ink puddle)
var liftHeight:Float = 12;

// Animations: Echo 2's chains are 32 frames, Echo 3's glitch 64; pixel art steps at 10 fps.
var chainsFrames:Int = 32;
var glitchFrames:Int = 64;
var animFps:Float = 10;

// Entrance: the windows rise into place one after another, with a small overshoot.
var openStagger:Float = 0.14;
var openTime:Float = 0.45;
var opened:Bool = false;

// Guards against the key press that opened this state still being
// "justPressed" on this state's very first update() — without this, the
// same physical ACCEPT press that confirmed "PLAY" on the previous menu
// would immediately confirm a card here too.
var canConfirm:Bool = false;

var lastMouseX:Float = -1;
var lastMouseY:Float = -1;

function create() {
	FlxG.camera.scroll.set(0, 0); // every screen resets its own camera
	bgColor = FlxColor.WHITE;

	buildCards();

	FlxG.mouse.visible = true;
	// Start from where the pointer already is, so a mouse resting on a window at entry does not count
	// as hover (it would override the keyboard selection on the very first frame).
	lastMouseX = FlxG.mouse.screenX;
	lastMouseY = FlxG.mouse.screenY;
	new FlxTimer().start(0.2, (_) -> canConfirm = true);
	new FlxTimer().start(openStagger * 2 + openTime, (_) -> finishOpening());
}

function buildCards() {
	var startX = (FlxG.width - (3 * windowW + 2 * cardGap)) / 2;
	cardBaseY = (FlxG.height - windowH) / 2 - cardRaise;

	for (i in 0...3) {
		var card = new FlxSprite();
		if (i == 0) {
			card.loadGraphic(Paths.image('menus/echo/vista_echo_1'));
		} else {
			card.loadGraphic(Paths.image(i == 1 ? 'menus/echo/vista_echo_chains' : 'menus/echo/vista_echo_glitch'), true, cellW, cellH);
			var frames = i == 1 ? chainsFrames : glitchFrames;
			card.animation.add('loop', [for (f in 0...frames) f], animFps, true);
			card.animation.play('loop');
		}
		card.antialiasing = false;
		// The sprite carries a margin of pencil overshoot: its hitbox is just the window.
		card.width = windowW;
		card.height = windowH;
		card.offset.set(cellMargin, cellMargin);

		var x = startX + i * (windowW + cardGap);
		cardBaseX.push(x);
		card.setPosition(x, cardBaseY + 48);
		card.alpha = 0;
		add(card);
		cards.push(card);

		var index = i;
		new FlxTimer().start(index * openStagger, (_) -> {
			FlxTween.tween(card, {y: cardBaseY}, openTime, {ease: FlxEase.backOut});
			FlxTween.tween(card, {alpha: 1}, 0.25);
		});
	}
}

function finishOpening() {
	opened = true;
	updateSelection();
}

// The selected window lifts a little; the others sit at their base. Waits for the entrance to end
// so the two tweens do not fight.
function updateSelection() {
	if (!opened) return;

	for (i in 0...cards.length) {
		FlxTween.cancelTweensOf(cards[i], ["y"]);
		var targetY = cardBaseY - (i == selectedIndex ? liftHeight : 0);
		FlxTween.tween(cards[i], {y: targetY}, 0.12, {ease: FlxEase.quadOut});
	}
}

function moveSelection(delta:Int) {
	selectedIndex = (selectedIndex + delta + cards.length) % cards.length;
	updateSelection();
}

// A locked window refuses: a quick horizontal shake that dies down.
function shake(index:Int) {
	var card = cards[index];
	var baseX = cardBaseX[index];
	new FlxTimer().start(0.035, (t) -> {
		card.x = t.loopsLeft == 0 ? baseX : baseX + (t.elapsedLoops % 2 == 0 ? -7 : 7) * (t.loopsLeft / 8);
	}, 8);
}

function confirmSelection() {
	if (!canConfirm || !opened)
		return;

	if (!echoUnlocked[selectedIndex]) {
		shake(selectedIndex);
		return;
	}

	FlxG.switchState(new ModState("StoryMapState"));
}

// Hover only counts while the mouse actually moves: a pointer resting on a window must not undo
// what the keyboard just selected.
function updateMouse() {
	var moved = FlxG.mouse.screenX != lastMouseX || FlxG.mouse.screenY != lastMouseY;
	lastMouseX = FlxG.mouse.screenX;
	lastMouseY = FlxG.mouse.screenY;

	if (moved && opened) {
		for (i in 0...cards.length) {
			if (i != selectedIndex && FlxG.mouse.overlaps(cards[i])) {
				selectedIndex = i;
				updateSelection();
			}
		}
	}

	if (FlxG.mouse.justPressed && opened && FlxG.mouse.overlaps(cards[selectedIndex]))
		confirmSelection();
}

function update(elapsed) {
	if (controls.LEFT_P)
		moveSelection(-1);
	else if (controls.RIGHT_P)
		moveSelection(1);

	updateMouse();

	if (controls.ACCEPT)
		confirmSelection();

	if (controls.BACK)
		FlxG.switchState(new ModState("MainMenuState"));
}

function destroy() {
	FlxG.mouse.visible = false;
}
